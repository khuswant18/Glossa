# Copy to server/.env for local runs, or set these in Vercel → Project → Settings → Environment Variables.
# They stay on the server; the extension and the website never see them.

# Any OpenAI-compatible chat-completions endpoint, its key, and model ids.
UPSTREAM_URL=
UPSTREAM_API_KEY=
UPSTREAM_MODEL=
UPSTREAM_FALLBACK_MODEL=

# Free-tier limits
DAILY_LIMIT=100
IP_DAILY_LIMIT=400
BURST_PER_MINUTE=20

# Lock the API to the Glossa extension id (see public/extension-key.json). Empty = any extension.
ALLOWED_EXTENSION_IDS=ldhjakhcccihmklmpphhdmfneofjenmd
# Public site origin, e.g. https://your-project.vercel.app
PUBLIC_ORIGIN=

# Shared rate-limit store (strongly recommended on Vercel). Upstash Redis REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

PORT=7717

# Copy to server/.env for local runs, or set these in Vercel → Project → Settings → Environment Variables.
# They stay on the server; the extension and the website never see them.

# Any OpenAI-compatible chat-completions endpoint, its key, and model ids.
UPSTREAM_URL=
UPSTREAM_API_KEY=
UPSTREAM_MODEL=
UPSTREAM_FALLBACK_MODEL=
# For gpt-oss models: low | medium | high (default low: ~3x faster, fewer tokens, same answers in testing).
UPSTREAM_REASONING_EFFORT=low

# Free-tier limits
DAILY_LIMIT=100
IP_DAILY_LIMIT=400
BURST_PER_MINUTE=20

# Lock the API to the Glossa extension id (see scripts/extension-key.json). Empty = any extension.
ALLOWED_EXTENSION_IDS=ldhjakhcccihmklmpphhdmfneofjenmd
# Public site origin, e.g. https://your-project.vercel.app
PUBLIC_ORIGIN=

# Shared rate-limit store (strongly recommended on Vercel). Upstash Redis REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anonymous usage counts (lookups/day, repeat lookups, active installs, D7/D30 retention).
# Set a long random token to read them: curl -H "Authorization: Bearer $STATS_TOKEN" https://your-site/v1/stats?days=30
# Empty = the /v1/stats endpoint is disabled (counts are still kept, in Redis when configured).
STATS_TOKEN=

# Private dashboard at /admin (traffic, downloads, installs, usage, retention, feedback).
# Leave ADMIN_PASSWORD empty to switch /admin off entirely. Use a long, unique password.
ADMIN_USER=admin
ADMIN_PASSWORD=

PORT=7717
